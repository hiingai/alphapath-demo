 "remedyActions": {
  "apply_rop145": {
   "label": "申请 ROP145（核实永久性居民身份证资格）",
   "desc": "满 7 年可独立申请核实资格，无须保证人同意。"
  },
  "switch_to_work_visa": {
   "label": "转换工作签证路径",
